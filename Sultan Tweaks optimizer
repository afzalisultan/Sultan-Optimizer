
@echo off
title Fortnite Mouse Keyboard FPS Boost
color 0A

echo ========================================
echo     MOUSE KEYBOARD FPS BOOST
echo ========================================
echo.

echo [1/4] Activating High Performance...
powercfg /setactive SCHEME_MIN

echo.
echo [2/4] Disabling mouse acceleration...
reg add "HKCU\Control Panel\Mouse" /v MouseSpeed /t REG_SZ /d 0 /f
reg add "HKCU\Control Panel\Mouse" /v MouseThreshold1 /t REG_SZ /d 0 /f
reg add "HKCU\Control Panel\Mouse" /v MouseThreshold2 /t REG_SZ /d 0 /f

echo.
echo [3/4] Opening Windows gaming settings...
start ms-settings:gaming-gamemode

echo.
echo [4/4] Opening mouse settings...
start ms-settings:mousetroubleshoot

echo.
echo ========================================
echo Gaming settings applied.
echo Restart Windows for best results.
echo ========================================

